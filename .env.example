# TaskForge Environment Configuration
ENVIRONMENT=development
PROJECT_NAME=TaskForge
VERSION=1.0.0
API_V1_STR=/api/v1

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskforge_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/taskforge_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Security
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
USE_RSA_ENCRYPTION=true

# Notification / Email
EMAILS_FROM_EMAIL=notifications@taskforge.internal
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_api_key_here
